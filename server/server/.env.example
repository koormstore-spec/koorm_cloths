PORT=5000
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=koorm_db
DB_PORT=3306
JWT_SECRET=change_this_to_a_long_random_secret
ADMIN_JWT_SECRET=change_this_to_a_different_long_random_secret
# Optional absolute path for structured backend error logs.
ERROR_LOG_PATH=./logs/error.log
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your_store_gmail@gmail.com
EMAIL_PASS=your_16_char_gmail_app_password
# Comma-separated list supported for multiple admin recipients
ADMIN_EMAIL=koormstore@gmail.com
# Browser access (CORS). koormcollection.com and www.koormcollection.com are
# always allowed, and so is any localhost / 127.0.0.1 port, so the frontend on
# http://localhost:5173 works against this server even in production.
# Extra sites, comma-separated (e.g. a staging frontend):
# CORS_ORIGINS=https://staging.koormcollection.com
# Set to false to block localhost frontends on the production server:
# ALLOW_LOCALHOST_ORIGINS=true
# Public storefront URL for order links in customer emails.
CLIENT_URL=https://koormcollection.com
# Public storefront origin used if an order photo is not available locally.
EMAIL_ASSET_BASE_URL=https://koormcollection.com
# Optional absolute path to the catalogue images directory for inline email photos.
# Defaults to ../client/public/images relative to the server directory.
# EMAIL_IMAGE_ROOT=/path/to/client/public/images

# Online payments (Razorpay). These stay on the server only; the browser never
# sees the secret. Leave the key fields blank to offer cash on delivery only.
#
# TRIAL: use test keys (Dashboard > Test Mode > Account & Settings > API Keys):
#   RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
# Checkout then shows a "Test mode" notice and no real money is charged.
#
# GO LIVE: generate keys in Live Mode, replace both values below with the
# rzp_live_ pair, create a live-mode webhook (its secret differs from the test
# one) and restart the server. The startup log shows which mode is active.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Dashboard > Webhooks > Add: URL https://<your-api-domain>/api/payments/webhook
# Events: payment.authorized, payment.captured, order.paid, refund.processed, refund.failed
RAZORPAY_WEBHOOK_SECRET=
